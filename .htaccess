# 1. Matikan daftar direktori (Directory Indexing)
Options -Indexes

# 2. Blokir akses ke file sensitif dan tersembunyi (.env, .git, .sql, .log, .bat, .exe, composer, dll)
<FilesMatch "(^\..*|\.(env.*|sql|log|bat|exe|cmd|sh|json|lock|md|docx))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Blokir akses langsung ke folder internal sensitif
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Tolak akses ke folder internal backend, storage, frontend/templates, vendor, tools
    RewriteRule ^(backend|storage|frontend/templates|vendor|tools)/ - [F,L]

    # Teruskan seluruh request publik yang sah ke frontend/public/
    RewriteCond %{REQUEST_URI} !^/frontend/public/
    RewriteRule ^(.*)$ frontend/public/$1 [L,QSA]
</IfModule>
