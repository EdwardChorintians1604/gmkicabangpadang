!/storage/backup/uploads/manifest.csv
/storage/backup/total/*
!/storage/backup/total/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep
/storage/sessions/*
!/storage/sessions/.gitkeep
/storage/temp/*
!/storage/temp/.gitkeep

# Unggahan Publik User
/frontend/public/uploads/berita/*
