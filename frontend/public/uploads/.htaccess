# =====================================================================
# GMKI CABANG PADANG - PERISAI ANTI-PHP2SHELL (UPLOADS LOCKDOWN)
# File: frontend/public/uploads/.htaccess
# Deskripsi: Mematikan total eksekusi PHP dan skrip berbahaya di folder unggahan
# =====================================================================

# 1. Matikan eksekusi mesin PHP pada seluruh versi
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# 2. Copot seluruh handler script berbahaya
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .phar .inc .cgi .pl .asp .aspx .shtml
SetHandler default-handler

# 3. Blokir mutlak file yang berekstensi script atau executable
<FilesMatch "(?i)\.(php[0-9]?|phtml|phar|inc|cgi|pl|py|sh|bash|exe|bat|cmd|dll|bin|shtml|asp|aspx|jsp|jspx|env|sql|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 4. Hanya izinkan ekstensi media & dokumen yang sah
<FilesMatch "(?i)\.(jpg|jpeg|png|webp|gif|pdf|csv|xlsx|txt)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</FilesMatch>

# 5. Nonaktifkan CGI dan Directory Listing
Options -ExecCGI -Indexes
