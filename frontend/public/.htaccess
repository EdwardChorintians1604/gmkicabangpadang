Options -Indexes -ExecCGI

# Hanya index.php yang boleh dieksekusi sebagai skrip PHP di public web root
<FilesMatch "(?i)\.(php[0-9]?|phtml|phar|inc|cgi|pl|py|sh|bash|bat|exe)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<Files "index.php">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</Files>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Perisai Anti-CVE-2024-4577 (Soft-Hyphen 0xAD / %AD CGI Argument Injection pada Windows)
    RewriteCond %{QUERY_STRING} ^(%ad|\xAD|-) [NC,OR]
    RewriteCond %{QUERY_STRING} (allow_url_include|auto_prepend_file|auto_append_file|php://input|phar://) [NC]
    RewriteRule ^ - [F,L]

    # Cegah akses ke file tersembunyi (.env, .git, dll)
    RewriteRule ^\.(.*)$ - [F]

    # Blokir akses langsung ke file script di dalam folder uploads & assets
    RewriteRule ^(uploads|assets)/.*\.(php[0-9]?|phtml|phar|cgi|pl|py|sh|bash|exe|bat)$ - [F,L]

    # Lewatkan berkas & direktori yang benar-benar ada secara fisik
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Arahkan semua request lainnya ke index.php
    RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
    # Header Keamanan
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    <FilesMatch "\.(css|js|png|jpg|jpeg|svg|woff2?)$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
</IfModule>
