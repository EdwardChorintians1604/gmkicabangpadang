# =====================================================================
# GMKI CABANG PADANG - KONFIGURASI LINGKUNGAN (.env)
# =====================================================================

# Aplikasi
APP_NAME="GMKI Cabang Padang"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE="Asia/Jakarta"
APP_LOCALE=id

# Database MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gmki_padang
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Keamanan & Sesi
APP_KEY=base64:gmki_padang_secure_secret_key_2026_salt
SESSION_LIFETIME=7200
SESSION_IDLE_TIMEOUT=900
SESSION_ABSOLUTE_TIMEOUT=28800
CSRF_LIFETIME=3600
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_DECAY=900

# Penyimpanan & Unggahan
MAX_UPLOAD_SIZE_MB=5
ALLOWED_IMAGE_TYPES="image/jpeg,image/png,image/webp"
ALLOWED_DOC_TYPES="application/pdf,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv"

# Backup
BACKUP_RETAIN_COUNT=3

# =====================================================================
# INTEGRASI GOOGLE DRIVE API (Offload Cloud Storage - 15 GB Gratis)
# =====================================================================
# Aktifkan untuk menyimpan berkas laporan keuangan & arsip langsung di Google Drive
# sehingga disk hosting (InfinityFree) tetap bersih dan bebas dari razia file-hosting.
GDRIVE_ENABLED=false
GDRIVE_SERVICE_ACCOUNT_JSON="storage/private/keys/google-service-account.json"
GDRIVE_FOLDER_ID=""
# Jika bernilai true, berkas fisik lokal langsung dihapus setelah berhasil diunggah ke Google Drive (menghemat Inode hosting)
GDRIVE_OFFLOAD_LOCAL=false

# =====================================================================
# SISTEM ANTREAN & BACKGROUND WORKER (QUEUE)
# =====================================================================
# 'sync'     : Eksekusi langsung tanpa daemon CLI (Wajib untuk InfinityFree / Shared Hosting gratis)
# 'database' : Eksekusi via background worker (membutuhkan 'php tools/worker.php' atau Web Cron)
QUEUE_CONNECTION=sync
CRON_SECRET_TOKEN="gmki_secret_cron_key_padang_2026"

