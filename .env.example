# =====================================================================
# GMKI CABANG PADANG - KONFIGURASI LINGKUNGAN (.env)
# =====================================================================

# Aplikasi
APP_NAME="GMKI Cabang Padang"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE="Asia/Jakarta"
APP_LOCALE=id

# Database MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gmki_padang
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Keamanan & Sesi
APP_KEY=base64:gmki_padang_secure_secret_key_2026_salt
SESSION_LIFETIME=7200
CSRF_LIFETIME=3600
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_DECAY=900

# Penyimpanan & Unggahan
MAX_UPLOAD_SIZE_MB=5
ALLOWED_IMAGE_TYPES="image/jpeg,image/png,image/webp"
ALLOWED_DOC_TYPES="application/pdf,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv"

# Backup
BACKUP_RETAIN_COUNT=3
